# Copy to .env.agent next to this file and fill in. Never commit .env.agent.
#
#   cp observability/.env.agent.example observability/.env.agent
#
# Everything here is read inside the container: config.alloy reads the OBS_*
# variables with sys.env(), and postgres_exporter reads the DATA_SOURCE_* ones.
# Nothing is interpolated by Compose, so a `$` needs no escaping.

# ── Identity ──────────────────────────────────────────────────────────────
# The same three values the app's own OBS_APP / OBS_ENV / OBS_HOST must carry —
# keep them in one place if the app is configured from this file too. They are
# stamped onto every metric and every log stream this agent forwards.
OBS_APP=
OBS_ENV=production
OBS_HOST=

# ── Where to push ─────────────────────────────────────────────────────────
# Native upstream paths, unrewritten. OBS_TRACES_URL is a base URL: the OTLP
# exporter appends /v1/traces itself.
OBS_PROM_URL=https://ingest.example.com/api/v1/write
OBS_LOKI_URL=https://ingest.example.com/loki/api/v1/push
OBS_TRACES_URL=https://ingest.example.com

# One credential per app+env. scripts/add-ingest-user.sh on the server mints it.
OBS_INGEST_USER=
OBS_INGEST_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────
# Docker emits one scrape target per (network × exposed port). Set this to the
# network the agent shares with the app if any container joins more than one,
# or a series gets duplicate samples. Unset matches every network.
#OBS_DOCKER_NETWORK=

# A single static target for something that cannot be discovered — a process on
# the host, a container that cannot EXPOSE its port. Unset disables it.
#OBS_EXTRA_TARGET=host.docker.internal:9100
#OBS_EXTRA_SERVICE=worker

# ── profile: postgres ─────────────────────────────────────────────────────
# postgres_exporter's own variable names. The role is created by
# postgres-exporter-init.sql; the password below has to match what that ran with.
DATA_SOURCE_URI=db:5432/appdb?sslmode=disable
DATA_SOURCE_USER=postgres_exporter
DATA_SOURCE_PASS=
