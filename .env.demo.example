# Copy to .env.demo.production, fill in, and paste it into the Dokploy service's
# environment UI. Never commit the filled-in copy.
#
#   cp .env.demo.example .env.demo.production
#
# Unlike .env.lgtm.example there is no local counterpart, because there is no
# local reader: the demo's local shape is compose.demo.yml, which takes what it
# needs from the Makefile and .env.lgtm. This file configures
# compose.demo.deploy.yml and nothing else, and the .production copy is a paste
# buffer and a record of what was pasted rather than a file anything loads.
#
# The platform writes these into a .env next to the compose file, which Compose
# reads for **interpolation**. So docs/deploy-server.md §3's rule applies to every
# value here: a `$` is eaten, `$$` collapses to one, and `$NAME` expands — what
# the container receives is not what this file shows. Keep secrets alphanumeric.
#
# Nothing here comes from another service's environment. Two Dokploy services are
# two Compose projects, so this one cannot reach prometheus/loki/tempo by name and
# has to say where it runs.
#
# This is also the worked example for an app of your own: swap the identity, the
# database and the load generator for yours and the rest carries over unchanged.

# ── Identity ──────────────────────────────────────────────────────────────
# One place, read by the agent and by both app containers — compose.demo.deploy.yml
# interpolates all three rather than setting them literally, which is what stops
# the two halves drifting apart. `env` is bounded to exactly three values by
# docs/labels.md; a deployed app is `production` even when it is a demo.
OBS_APP=demo
OBS_ENV=production
OBS_HOST=
OBS_VERSION=0.1.0

# OBS_LOG_FORMAT is not here: compose.demo.deploy.yml pins it to json, because the
# agent's stage.json parses JSON and a console-rendered line would arrive as an
# unparsed blob with no level and no trace_id.
OBS_LOG_LEVEL=INFO

# ── Network ───────────────────────────────────────────────────────────────
# Docker network names are global to the host, and this box also runs the LGTM
# stack. The agent's OBS_DOCKER_NETWORK follows this, which is what keeps every
# other container on the box out of this app's metrics and logs.
OBS_NETWORK=demo-obs

# ── Where to push ─────────────────────────────────────────────────────────
# The public ingest host, not an in-network address, even when the server shares
# the box: a separate Compose project means the demo goes out and back in through
# Traefik exactly as an app on any other host would. Exercising that path is the
# reason to run the demo here rather than beside the server.
#
# Native upstream paths, unrewritten. OBS_TRACES_URL is a base URL; the OTLP
# exporter appends /v1/traces itself.
OBS_PROM_URL=https://ingest.example.com/api/v1/write
OBS_LOKI_URL=https://ingest.example.com/loki/api/v1/push
OBS_TRACES_URL=https://ingest.example.com

# One credential per app+env, minted on the server with
# ./scripts/add-ingest-user.sh demo-production — it prints both halves, this one
# and the bcrypt hash to append to the server's INGEST_USERS.
OBS_INGEST_USER=
OBS_INGEST_PASSWORD=

# ── Profiles ──────────────────────────────────────────────────────────────
# Dokploy gives no place to pass --profile; Compose reads this from the same .env.
# Without it cadvisor and postgres-exporter never start, and the Postgres and
# Infrastructure dashboards stay empty with nothing on screen to say why.
#
# Note what cAdvisor and prometheus.exporter.unix report on a box that also runs
# the server: the *host*. Every container on it — the LGTM stack's own, the
# platform's — arrives labelled with this app. Correct on a dedicated app host,
# an artefact of sharing one. Logs are unaffected; OBS_NETWORK scopes those.
COMPOSE_PROFILES=postgres,containers

# ── Database ──────────────────────────────────────────────────────────────
# No port is published, so neither reaches anything off-box. DATA_SOURCE_PASS is
# the exporter's own least-privilege role — not the application account — created
# on first boot by the init script baked into demo/db/Dockerfile.
DEMO_DB_PASSWORD=
DATA_SOURCE_URI=demo-db:5432/demo?sslmode=disable
DATA_SOURCE_USER=postgres_exporter
DATA_SOURCE_PASS=

# ── Load ──────────────────────────────────────────────────────────────────
# Lower than the local demo's 5/s: this one runs indefinitely into a 30-day TSDB
# rather than for the length of a test.
LOADGEN_RATE=2

# ── Optional ──────────────────────────────────────────────────────────────
# Empty means no error reporting, which is the default. Fill in with the DSN
# GlitchTip's UI hands you — the public errors.<domain> one, not a container name:
# deployed as its own service GlitchTip is a separate Compose project with its own
# `obs` network, so the in-network path does not exist from here.
OBS_ERROR_DSN=

# Three more are accepted and left out on purpose. OBS_EXTRA_TARGET and
# OBS_EXTRA_SERVICE are agent-generic and documented in agent/.env.agent.example;
# the demo has nothing that cannot be discovered. OBS_INGEST_TLS_INSECURE exists
# so this stack's own end-to-end test can push through Traefik on a laptop — in a
# deployed environment it would make the credential above readable by whoever
# terminates the connection, so it has no place in this file.
