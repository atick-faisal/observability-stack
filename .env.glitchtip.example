# Copy to .env.glitchtip and fill in. Never commit .env.glitchtip.
#
#   cp .env.glitchtip.example .env.glitchtip
#   make glitchtip-up
#
# Separate from .env.server on purpose. GlitchTip's database password and secret key
# have nothing to do with Grafana's admin account or the ingest credentials, and one
# file for all of them means you cannot hand over or rotate one without the others.
#
# Unlike .env.server, this file is NOT interpolated by Compose — `env_file:` hands it
# to the containers as-is. So write values literally: a `$` is a `$`, and none of the
# `$$`-doubling that .env.server needs applies here. That is why the secret key and
# the password live in this file rather than in compose.glitchtip.yml.
#
# Every variable below is read by the GlitchTip containers except POSTGRES_DB /
# POSTGRES_USER / POSTGRES_PASSWORD, which are read by its Postgres. They are in one
# file so DATABASE_URL cannot drift from the credentials it has to match.

# ── Database ──────────────────────────────────────────────────────────────
# A dedicated role and database, not the `postgres` superuser in the `postgres`
# database. GlitchTip needs no rights beyond its own schema.
POSTGRES_DB=glitchtip
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=

# Must agree with the three above, and the host is the compose service name.
# Only ever read on the private `glitchtip` network.
DATABASE_URL=postgres://glitchtip:CHANGE_ME@glitchtip-postgres:5432/glitchtip

# ── Cache and queue ───────────────────────────────────────────────────────
# Celery's broker as well as the cache. Setting it to an empty string makes
# GlitchTip fall back to the database, which works and is slower.
VALKEY_URL=redis://glitchtip-valkey:6379/0

# ── Application ───────────────────────────────────────────────────────────
# openssl rand -hex 32
# Changing it invalidates every session and every password-reset link.
SECRET_KEY=

# The port GlitchTip listens on inside the container. compose.glitchtip.yml's
# Traefik label and healthcheck both assume 8000; change both if you change this.
PORT=8000

# Every Host header GlitchTip will be asked to answer on, comma-separated. The
# in-network service name has to be here as well as the public hostname: an app
# reporting to http://<key>@glitchtip-web:8000/1 sends `Host: glitchtip-web:8000`,
# and Django rejects a host it does not know with a 400 before any view runs.
#
# The default is ["*"], and GlitchTip logs a warning about it on every boot.
ALLOWED_HOSTS=localhost,glitchtip-web,errors.example.com

# How long an event is kept. Deliberately matched to Prometheus's 30d rather than
# left at the 90d default: an error you cannot pull up the metrics, logs and trace
# for is an error you cannot investigate, and those expire at 30d / 14d / 7d.
#
# The name matters. GLITCHTIP_MAX_EVENT_LIFE_DAYS still works but is legacy
# (settings.py:163 reads it only as the fallback default for this one).
GLITCHTIP_RETENTION_DAYS=30

# Anyone who can reach errors.<domain> can create an account while this is true,
# and true is the default. Leave it true for the first signup — that account becomes
# the first organisation's owner — then set it false and `make glitchtip-up` again.
# Invite everyone else.
#
# The name matters here too: ENABLE_OPEN_USER_REGISTRATION is not a GlitchTip
# setting, and setting it has no effect and produces no error.
ENABLE_USER_REGISTRATION=false

# ── Email ─────────────────────────────────────────────────────────────────
# consolemail:// prints mail to the container's stdout instead of sending it, which
# is fine locally and is not fine in production: password-reset links are mail, so
# with no real transport the only account recovery is a shell on the box.
#
#   smtp://user:password@smtp.example.com:587
#
# A `#` or `@` in the password has to be percent-encoded — this is a URL.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=errors@example.com

# ── Celery ────────────────────────────────────────────────────────────────
# min,max concurrency. Unset means one worker per CPU core, which on a shared VPS
# is how GlitchTip ends up competing with Prometheus for memory.
CELERY_WORKER_AUTOSCALE=1,3
