# Copy to .env.glitchtip and fill in. Never commit .env.glitchtip.
#
#   cp .env.glitchtip.example .env.glitchtip
#   make glitchtip-up
#
# Separate from .env.server on purpose. GlitchTip's database password and secret key
# have nothing to do with Grafana's admin account or the ingest credentials, and one
# file for all of them means you cannot hand over or rotate one without the others.
# Deploying GlitchTip as its own service on a platform like Dokploy makes that split
# operational: only this file's contents go in that service's environment.
#
# Compose interpolates these values, exactly as it does .env.server's — so the same
# rule applies: **a single `$` in a value is eaten, and has to be written `$$`.**
# Everything below is generated or chosen; keep it alphanumeric and the trap never
# fires. `openssl rand -hex 32` cannot produce a `$`, and an alphanumeric database
# password avoids both this and the percent-encoding DATABASE_URL would otherwise
# need. scripts/add-ingest-user.sh generates ingest passwords the same way.
#
# The one place to watch is EMAIL_URL, whose password is not yours to choose.

# ── Database ──────────────────────────────────────────────────────────────
# A dedicated role and database, not the `postgres` superuser in the `postgres`
# database. GlitchTip needs no rights beyond its own schema.
#
# compose.glitchtip.yml assembles DATABASE_URL from these three, so there is no
# fourth copy of the password to keep in step.
POSTGRES_DB=glitchtip
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=

# ── Cache and queue ───────────────────────────────────────────────────────
# Celery's broker as well as the cache. Setting it to an empty string makes
# GlitchTip fall back to the database, which works and is slower.
VALKEY_URL=redis://glitchtip-valkey:6379/0

# ── Application ───────────────────────────────────────────────────────────
# openssl rand -hex 32
# Changing it invalidates every session and every password-reset link.
SECRET_KEY=

# The port GlitchTip listens on inside the container. compose.glitchtip.yml's
# Traefik label and healthcheck both assume 8000; change all three if you change it.
# Named GLITCHTIP_PORT rather than PORT because this is pasted into environment UIs
# where `PORT` collides with everything.
GLITCHTIP_PORT=8000

# Every Host header GlitchTip will be asked to answer on, comma-separated. Django
# rejects a host it does not know with a 400 before any view runs, so a missing entry
# here looks like a broken deploy rather than a configuration mistake.
#
# Three kinds of entry, and you want all three that apply:
#   errors.example.com   the public hostname, once it is behind the edge
#   glitchtip-web        what a same-project app's `Host:` header carries when it
#                        reports to http://<key>@glitchtip-web:8000/1
#   localhost            the 127.0.0.1:8001 port compose.glitchtip.local.yml opens
#
# There is no default: compose.glitchtip.yml fails the render without it, because
# getting this wrong is otherwise silent until the first request.
ALLOWED_HOSTS=localhost,glitchtip-web,errors.example.com

# How long an event is kept. Deliberately matched to Prometheus's 30d rather than
# left at the 90d default: an error you cannot pull up the metrics, logs and trace
# for is an error you cannot investigate, and those expire at 30d / 14d / 7d.
#
# The name matters. GLITCHTIP_MAX_EVENT_LIFE_DAYS still works but is legacy
# (settings.py:163 reads it only as the fallback default for this one).
GLITCHTIP_RETENTION_DAYS=30

# Anyone who can reach errors.<domain> can create an account while this is true.
# It ships true because the first signup is how the first account is made, and that
# account becomes the first organisation's owner — with it false from the start there
# is no way in short of `manage.py createsuperuser` on the box. Set it false straight
# after that signup and bring the stack up again. Invite everyone else.
#
# The name matters here too: ENABLE_OPEN_USER_REGISTRATION is not a GlitchTip
# setting, and setting it has no effect and produces no error.
ENABLE_USER_REGISTRATION=true

# ── Email ─────────────────────────────────────────────────────────────────
# consolemail:// prints mail to the container's stdout instead of sending it, which
# is fine locally and is not fine in production: password-reset links are mail, so
# with no real transport the only account recovery is a shell on the box.
#
#   smtp://user:password@smtp.example.com:587
#
# This is a URL, so a `#` or `@` in the password has to be percent-encoded — and it
# is interpolated, so a `$` has to be doubled. The one value here you did not choose.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=errors@example.com

# ── Celery ────────────────────────────────────────────────────────────────
# min,max concurrency. Unset means one worker per CPU core, which on a shared VPS
# is how GlitchTip ends up competing with Prometheus for memory.
CELERY_WORKER_AUTOSCALE=1,3
