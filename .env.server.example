# Copy to .env.server and fill in. Never commit .env.server.
#
#   cp .env.server.example .env.server
#   make up

# Grafana admin account. Read once, when the admin user is first created —
# editing this later does nothing. To actually reset it, either change the
# password in the UI, or start over:
#
#   make down && docker volume rm observability_grafana_data && make up
#
# Avoid `$` in the password. Compose interpolates --env-file values, so `$$`
# collapses to a single `$` and `$NAME` expands to that variable, and what
# Grafana receives is not what this file shows.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Must match how Grafana is reached, or share/alert links point at the wrong
# host. Set it to https://grafana.${OBS_DOMAIN} once it is behind the edge.
GF_SERVER_ROOT_URL=http://localhost:3000

# ── Edge ──────────────────────────────────────────────────────────────────
# The stack answers on grafana.${OBS_DOMAIN} and ingest.${OBS_DOMAIN}, and at M8
# errors.${OBS_DOMAIN}. Create one A record per name pointing at the VPS.
OBS_DOMAIN=example.com

# Only read by compose.edge.yml, which is the Traefik to run when the host has
# none. Let's Encrypt rejects an address whose domain is not a real TLD.
ACME_EMAIL=you@example.com

# Which docker network the edge proxy reaches these containers on. The defaults
# suit compose.edge.yml. Where a proxy already exists, name its network and mark
# it external instead — on a Dokploy host:
#
#   OBS_EDGE_NETWORK=dokploy-network
#   OBS_EDGE_EXTERNAL=true
#
# Note what that shares: every container on that network can reach prometheus,
# loki and tempo directly, without the basic auth below. The `obs` network stays
# private, but the edge network is only as trusted as the host.
#OBS_EDGE_NETWORK=observability_edge
#OBS_EDGE_EXTERNAL=false
